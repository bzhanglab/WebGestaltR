TARGET_DIR = ./rust/target
VENDORING = @VENDORING@
OFFLINE_OPTION = @OFFLINE_OPTION@
LIBDIR = $(TARGET_DIR)/release
STATLIB = $(LIBDIR)/libWebGestaltR.a
PKG_LIBS = -L$(LIBDIR) -lWebGestaltR @WRAP_FLAGS@
TARGET = @TARGET@

all: C_clean

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo

# ~/.cargo/bin is not always on PATH — CRAN's macOS builders are the case in point.
# Every line of a recipe runs in its own shell, so extending PATH on the cargo line
# alone left the version check below to run without it, fail with "rustc: No such file
# or directory", and abort the build before cargo was ever reached. One definition,
# used by both.
CARGO_PATH = $(PATH):$(HOME)/.cargo/bin

$(STATLIB):
	@export PATH="$(CARGO_PATH)" && rustc --version
	if [ "$(VENDORING)" = "yes" ]; then \
	  $(TAR) --extract --xz -f ./rust/vendor.tar.xz -C ./rust && \
	    mkdir -p ./.cargo && \
	    cp ./config.toml ./.cargo/config.toml; \
	fi
	# In some environments, ~/.cargo/bin might not be included in PATH, so we need
	# to set it here to ensure cargo can be invoked. It is appended to PATH and
	# therefore is only used if cargo is absent from the user's PATH.
	if [ "$(NOT_CRAN)" != "true" ]; then \
		export CARGO_HOME=$(CARGOTMP); \
	fi && \
		@BEFORE_CARGO_BUILD@ export PATH="$(CARGO_PATH)" &&\
		cargo build --lib --jobs 2 --release --manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR) $(OFFLINE_OPTION)
	if [ "$(NOT_CRAN)" != "true" ]; then \
		rm -Rf $(CARGOTMP) && \
		rm -Rf $(LIBDIR)/build; \
	fi
	@AFTER_CARGO_BUILD@

C_clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS)

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) rust/target
